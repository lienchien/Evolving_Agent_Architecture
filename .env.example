# Copy values into your process environment; this file is not auto-loaded.
# development and test use only the Phase 1 mock/SQLite/subprocess adapters.
# production-like is intentionally blocked until authentication and isolation exist.
APP_PROFILE=development

# Phase 1.5-B adapter is isolated; the API runtime still rejects real providers.
# Do not commit API keys or other secrets.
# Offline preflight: LLM_PROVIDER=litellm and LLM_MODEL=openrouter/<provider>/<model>
# or nvidia_nim/<provider>/<model>. Inject OPENROUTER_API_KEY or
# NVIDIA_NIM_API_KEY in the process environment; never put their values here.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
# Optional OpenRouter-only controls for the standalone LiteLLM adapter.
# Blank preserves provider defaults. For the verified free-model smoke test,
# use LLM_REASONING_EFFORT=none and LLM_RESPONSE_FORMAT=json_object.
LLM_REASONING_EFFORT=
LLM_RESPONSE_FORMAT=

# Local-only standalone adapter: LLM_PROVIDER=ollama, LLM_MODEL=<local name:tag>.
# Uses http://127.0.0.1:11434 only. Leave OpenRouter output controls blank.
# LLM_MAX_OUTPUT_TOKENS must be smaller than the context window.
OLLAMA_CONTEXT_TOKENS=4096

# Currently a SQLite file path, not a PostgreSQL or sqlite:// DSN.
DATABASE_URL=capability_library.db
REPORT_DIRECTORY=capability_library

# Docker is reserved for Phase 1.5-D; subprocess is not a security sandbox.
SANDBOX_BACKEND=subprocess
SANDBOX_TIMEOUT_SECONDS=5

# Existing bounded retry policy: hard maximum cannot exceed 3.
RETRY_HARD_MAX=3
RETRY_BACKOFF_MS=0

# Reserved for Phase 1.5-E. Nonzero values and enabled Builder fail startup
# until budget enforcement and the controlled Builder are implemented.
BUILDER_MAX_TOKENS=0
BUILDER_MAX_COST_USD=0
ENABLE_CODE_BUILDER=false
